{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ORBIT OS",
  "version": "1.0.1",
  "identifier": "com.orbitos.nebula",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "ORBIT OS — Mission Control",
      "width": 1320,
      "height": 880,
      "minWidth": 720,
      "minHeight": 600,
      "resizable": true,
      "fullscreen": false,
      "center": true,
      "decorations": true,
      "backgroundColor": "#070D18"
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "targets": ["nsis", "msi"],
    "category": "Productivity",
    "shortDescription": "Personal command center",
    "longDescription": "ORBIT OS — Your Digital Universe",
    "resources": {
      "resources/downloads/com.orbitos.creator.streamDeckPlugin": "downloads/com.orbitos.creator.streamDeckPlugin"
    },
    "windows": { "nsis": { "displayLanguageSelector": false } }
  }
}
